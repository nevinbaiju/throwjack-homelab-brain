# Copy to litellm.env and fill in. chmod 600 litellm.env
#
# Format rules that actually bite:
#   no quotes, no spaces around =, no trailing spaces, no inline comments.
#   A quoted value stores the quotes AS PART OF THE VALUE and you get a 401
#   with a key that looks correct in every log.
#
# Free keys: https://freellm.net lists current providers and their limits.

GROQ_API_KEY=
GEMINI_API_KEY=
# NVIDIA_NIM_API_KEY=
# OPENROUTER_API_KEY=

LITELLM_MASTER_KEY=     # same value as in .env
