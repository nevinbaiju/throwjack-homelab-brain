# Copy to .env and fill in. chmod 600 .env
# Generate the two random ones with: openssl rand -base64 32

BRAIN_TOKEN=            # bearer token for the CLI and iOS Shortcuts
CALDAV_USER=            # must match the username in radicale/users
CALDAV_PASSWORD=        # must match the password in radicale/users
LITELLM_MASTER_KEY=     # must match the same key in litellm.env

# Browser login. Set these with ./brain.sh setpass rather than by hand —
# the password is scrypt-hashed and the plaintext never touches disk.
BRAIN_ADMIN_USER=
BRAIN_ADMIN_PASSWORD_HASH=

# Where data lives. Defaults suit the machine this was built on; override if
# your storage is elsewhere. These are read by compose.yaml, not by the app.
# BRAIN_DATA=/var/mnt/storage/brain
# RADICALE_DATA=/var/mnt/storage/radicale
# SYNCTHING_CONFIG=/var/home/youruser/.local/share/syncthing
